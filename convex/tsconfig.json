{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": false,
    "types": ["node"],
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*"]
}
